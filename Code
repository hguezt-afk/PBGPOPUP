
<style>
/* === MAP TIP ADAPTIF UNTUK QGIS DESKTOP === */

/* Reset tampilan webview bawaan QGIS */
html, body {
    margin: 0;
    padding: 0;
    height: auto !important;
    overflow: visible !important;
    background: transparent !important;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Kontainer utama */
.map-tip-container {
    width: auto !important;
    max-width: 360px;
    background: white;
    border-radius: 10px;
    border: 1px solid #e1e5e9;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    overflow: visible !important;
}

/* Header */
.map-tip-header {
    background: linear-gradient(135deg, #2c5aa0 0%, #1e3a8a 100%);
    color: white;
    padding: 12px 18px;
    font-size: 20px;
    font-weight: 700;
    border-radius: 10px 10px 0 0;
}

/* Konten utama */
.map-tip-content {
    padding: 14px;
    overflow: visible !important;
}

/* Baris data */
.map-tip-row {
    display: flex;
    margin-bottom: 8px;
    align-items: flex-start;
}

.map-tip-label {
    font-weight: 600;
    color: #374151;
    font-size: 18px;
    min-width: 120px;
    flex-shrink: 0;
}

.map-tip-value {
    color: #111827;
    font-size: 18px;
    line-height: 1.4;
	min-width: 500px;
	word-wrap: break-word; /* biar teks panjang turun ke baris baru */
    white-space: normal; /* biar teks tidak maksa satu baris */
    flex: 1;
}

/* Status */
.map-tip-status {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
	 white-space: normal; /* biar teks status panjang turun ke bawah */
    word-wrap: break-word;
    line-height: 1.3;
    text-transform: uppercase;
}
.status-approved { background: #d1fae5; color: #065f46; }
.status-pending { background: #fef3c7; color: #92400e; }
.status-rejected { background: #fee2e2; color: #991b1b; }
.status-expired { background: #e5e7eb; color: #374151; }

.map-tip-divider {
    height: 1px;
    background: #f3f4f6;
    margin: 10px 0;
}

/* === Bagian Gambar Adaptif === */
.map-tip-image-container {
    margin-top: 12px;
    text-align: center;
    width: 100%;
    overflow: visible !important;
    display: flex;
    justify-content: center;
}

.map-tip-image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 350px; /* Batasi tinggi maksimal agar popup tidak terlalu panjang */
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    border: 2px solid #e5e7eb;
    box-sizing: border-box;
}

/* Caption */
.image-caption {
    font-size: 11px;
    color: #6b7280;
    padding: 5px 0 0 0;
    display: block;
    text-align: center;
}
.slf-value {
    min-width: 0 !important;
    white-space: normal !important;
    word-wrap: break-word !important;
}

/* Styling khusus untuk status SLF */
.slf-status {
    display: inline-block;
    padding: 5px 10px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    border-radius: 10px;
    white-space: normal !important;
    word-break: break-word !important;
    text-align: left;
    max-width: 100%;
    box-sizing: border-box;
}

/* Warna status bisa diatur ulang biar lebih jelas */
.slf-status.status-pending {
    background: #fde68a; /* lebih lembut dari kuning tua */
    color: #92400e;
}


</style>

<div class="map-tip-container">
    <div class="map-tip-header">
        Database PBG
    </div>
    <div class="map-tip-content">
	  
        <div class="map-tip-row">
            <div class="map-tip-label">Pemilik</div>
            <div class="map-tip-value">[% "Nama Pemilik" %]</div>
        </div>
        
        <div class="map-tip-divider"></div>
        
        <div class="map-tip-row">
            <div class="map-tip-label">Fungsi</div>
            <div class="map-tip-value">[% "Fungsi" %]</div>
        </div>
		
		<div class="map-tip-row">
            <div class="map-tip-label">Sub</div>
            <div class="map-tip-value"> [% "Sub Fungsi" %]</div>
        </div>
		
		  <div class="map-tip-row">
            <div class="map-tip-label"> Jenis </div>
            <div class="map-tip-value"> [% "Nama Bangunan" %] </div>
        </div>
        
        <div class="map-tip-row">
            <div class="map-tip-label">Luas Persil </div>
            <div class="map-tip-value"> [% "Luas Bangunan (m2)" %] m² </div>
        </div>
        
        <div class="map-tip-divider"></div>
		
		<div class="map-tip-row">
            <div class="map-tip-label">Luas Lahan </div>
            <div class="map-tip-value"> [% "Luas Tanah (m2)" %] m² </div>
        </div>
        
        <div class="map-tip-divider"></div>
		
		 <div class="map-tip-row">
            <div class="map-tip-label">Jmlh Lantai </div>
            <div class="map-tip-value"> [% "Jumlah Lantai" %] Lantai </div>
        </div>
		
        <div class="map-tip-divider"></div>
		
        <div class="map-tip-row">
    <div class="map-tip-label">SK PBG</div>
    <div class="map-tip-value">
        <span class="map-tip-status 
                [% CASE
                   WHEN "Status PBG" = 'SK PBG Terbit' THEN 'status-approved'
                   WHEN "Status PBG" = 'Perbaikan Dokumen' THEN 'status-warning' 
                   WHEN "Status PBG" = 'Proses Penerbitan SKRD' THEN 'status-pending'
                   WHEN "Status PBG" = 'Pelaksanaan Konsultasi' THEN 'status-pending'
                   ELSE 'status-expired' END 
                %]">
            [% "Status PBG" %]
        </span>
    </div>
</div>
        
      <div class="map-tip-row">
    <div class="map-tip-label">SK SLF</div>
    <div class="map-tip-value slf-value">
        <span class="map-tip-status slf-status
            [% CASE
               WHEN "Status SLF" = 'SLF Terbit' THEN 'status-approved'
               WHEN "Status SLF" = 'Menunggu Penugasan Penilik' THEN 'status-pending'
               WHEN "Status SLF" = 'Verifikasi Dokumen Akhir' THEN 'status-pending'
               WHEN "Status SLF" = 'Belum Terbit' THEN 'status-rejected'
               ELSE 'status-expired' END 
            %]">
            [% "Status SLF" %]
        </span>
    </div>
</div>
   <div style="clear: both; margin-top: 15px;"></div>
        <div class="map-tip-image-container">
            <img class="map-tip-image" src="file:///[% "Foto Bangunan" %]" alt="Foto Bangunan">
          
        </div>     
        
        
    </div>
</div



